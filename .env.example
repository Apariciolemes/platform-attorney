# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=platform_attorney
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# API
API_PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Documentação em /api/docs; use false para desligar (ex.: produção)
SWAGGER_ENABLED=true

# Frontend (docker)
WEB_PORT=8080

# Storage S3. STORAGE_ENDPOINT vazio = storage local (SeaweedFS) do docker-compose:
# a API usa http://storage:8333 dentro do Docker e http://localhost:8333 fora dele.
# Para usar o Cloudflare R2 ou a AWS, veja o README e troque estes valores.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=recordings
STORAGE_ACCESS_KEY_ID=devaccesskey
STORAGE_SECRET_ACCESS_KEY=devsecretkey
STORAGE_FORCE_PATH_STYLE=true

# Fila (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Transcrição — qualquer API compatível com a da OpenAI (/audio/transcriptions).
# Padrão: OpenAI Whisper. Crie a chave em https://platform.openai.com/api-keys
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
# whisper-1 será desligado pela OpenAI em 26/02/2027; o substituto gpt-transcribe já é suportado.
STT_MODEL=whisper-1
# Preço em US$/minuto para a página de custos. Vazio = tabela oficial da OpenAI;
# preencha ao usar outro provedor (ex.: Groq) ou se a OpenAI mudar o preço.
STT_PRICE_PER_MINUTE_USD=
TRANSCRIPTION_LANGUAGE=pt

# Revisão do texto por IA depois da transcrição (concordância, pontuação, clareza).
# Usa a Responses API da OpenAI; sem CORRECTION_API_KEY, usa a mesma chave da transcrição.
CORRECTION_ENABLED=true
CORRECTION_MODEL=gpt-6-luna
CORRECTION_BASE_URL=https://api.openai.com/v1
CORRECTION_API_KEY=
