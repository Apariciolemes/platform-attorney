# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=platform_attorney
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
DB_LOGGING=false

# API
API_PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Frontend (docker)
WEB_PORT=8080

# Storage S3 — padrão: storage local (SeaweedFS) do docker-compose.
# No Docker, a API e o worker usam http://storage:8333 automaticamente.
# Para usar o Cloudflare R2, veja o README e troque estes valores.
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_BUCKET=recordings
STORAGE_ACCESS_KEY_ID=devaccesskey
STORAGE_SECRET_ACCESS_KEY=devsecretkey
STORAGE_FORCE_PATH_STYLE=true

# Fila (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Transcrição (Groq Whisper) — crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
TRANSCRIPTION_LANGUAGE=pt
